<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fittin_indigo</item>
        <item name="colorPrimaryDark">@color/fittin_indigo</item>
        <item name="colorAccent">@color/fittin_accent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Indigo behind the webview: the same colour as the splash and the /app welcome screen,
             so there is no white frame between them. -->
        <item name="android:windowBackground">@color/fittin_indigo</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Android 12+ always shows a system splash (an icon on a colour). The wordmark sits inside
         the 192dp circle of a 288dp canvas (res/drawable/splash_icon.png). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fittin_indigo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
