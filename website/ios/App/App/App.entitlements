<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Must match the App ID be.fittin.app in the Apple Developer portal (automatic signing syncs it).
     aps-environment: Xcode rewrites it to "production" for App Store / TestFlight signing. -->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:fittin.be</string>
		<string>webcredentials:fittin.be</string>
	</array>
</dict>
</plist>
